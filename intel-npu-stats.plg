<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "intel-npu-stats">
<!ENTITY author    "RyRyMason">
<!ENTITY version   "2026.10.17">
<!ENTITY md5       "e7ccd574ba9c21e23a09dd1fdcbf7bdb">
<!ENTITY gitURL    "https://raw.githubusercontent.com/RyRyMason/unraid-intel-npu-stats/main">
<!ENTITY pluginURL "&gitURL;/&name;.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="&pluginURL;"
        min="6.12.0"
        icon="microchip"
        support="https://github.com/RyRyMason/unraid-intel-npu-stats/issues">

<CHANGES>
###2026.10.17
- Initial release: read-only dashboard tile for Intel NPU busy %, clock, memory and scheduler mode (intel_vpu sysfs).
</CHANGES>

<!-- Pre-install: remove old package versions from the flash and any unpackaged dev copy in RAM -->
<FILE Run="/bin/bash">
<INLINE>
find &plgPATH; -maxdepth 1 -name '&name;-*.txz' ! -name '&name;-&version;-x86_64-1.txz' -delete 2>/dev/null
rm -rf &emhttp;
</INLINE>
</FILE>

<!-- Package: cached on the flash, (re)installed into RAM at every boot -->
<FILE Name="&plgPATH;/&name;-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>&gitURL;/pkg/&name;-&version;-x86_64-1.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- Post-install: report whether the NPU counters are available -->
<FILE Run="/bin/bash">
<INLINE>
if ls /sys/bus/pci/drivers/intel_vpu/0000:*/npu_busy_time_us >/dev/null 2>&amp;1; then
  echo "&name; &version;: Intel NPU counters found."
else
  echo "&name; &version;: WARNING - intel_vpu npu_busy_time_us not found. Tile will show n/a (needs Intel Core Ultra NPU and kernel 6.11+)."
fi
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &name;-&version;-x86_64-1 2>/dev/null
rm -rf &emhttp;
rm -rf &plgPATH;
echo "&name; removed."
</INLINE>
</FILE>

</PLUGIN>
